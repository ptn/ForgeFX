{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build:*)",
      "Bash(npm run check:browser)",
      "Bash(tsx test/:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm run dev:*)",
      "Bash(npm start:*)",
      "Bash(npm run probe:*)",
      "Bash(npx tsx scripts/sweep-routes.ts:*)",
      "Bash(docker build:*)",
      "Bash(docker compose:*)",
      "Bash(docker run:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Read(./server/.env)",
      "Read(./server/.env.*)",
      "Read(./server/tap.log)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(server/dist/**)",
      "Write(server/dist/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
