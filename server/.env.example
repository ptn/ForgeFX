# ForgeFX cloud config — copy to `.env` (gitignored) to enable cloud sync against your own Supabase
# project. The publishable/anon key is safe to expose (RLS enforces per-user access). NEVER put the
# service-role key, DB password, or any secret here. With these unset, ForgeFX runs with cloud off.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
AXIS_CLOUD=1

# Telemetry / diagnostics (ships dark; default off). The on-demand "Upload Debug Log" report only needs
# the SUPABASE_* values above (it uploads to the debug-reports bucket). Live RUM telemetry additionally
# needs AXIS_TELEMETRY=1 plus a Grafana Faro collector — and still requires per-user consent in Axis.
# AXIS_TELEMETRY=1
# AXIS_FARO_URL=https://faro-collector-...grafana.net/collect
# AXIS_TELEMETRY_KEY=your-faro-app-key
